is_global = true

# Docs
# CAXXXX        Microsoft     https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/quality-rules/
# SXXXX         Sonar         https://github.com/SonarSource/sonar-dotnet
# REFLXXX       Reflection    https://github.com/DotNetAnalyzers/ReflectionAnalyzers
# RCSXXXX       Roslynator    https://josefpihrt.github.io/docs/roslynator/analyzers/
# MAXXXX        Meziantou     https://github.com/meziantou/Meziantou.Analyzer/tree/main
# IDISPXXX      IDisposable   https://github.com/DotNetAnalyzers/IDisposableAnalyzers/blob/master/README.md
# SSXXXX        SharpSource   https://github.com/Vannevelj/SharpSource
# VSTHRDXXX     VS threading  https://github.com/microsoft/vs-threading/tree/main
# MTXXXX        Multithread   https://github.com/SmartAnalyzers/MultithreadingAnalyzer
# RSXXXX        BannedAPI     https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/Microsoft.CodeAnalysis.BannedApiAnalyzers/Microsoft.CodeAnalysis.BannedApiAnalyzers.md
# xUnitXXXX     xUnit         https://xunit.net/xunit.analyzers/rules/
# IDEXXXX       Roslyn IDE    https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/
# CSXXXX        C# compiler   https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/compiler-messages/

# Documented overlaps according to https://github.com/meziantou/Meziantou.Analyzer/blob/main/docs/comparison-with-other-analyzers.md
dotnet_diagnostic.MA0010.severity = none # Duplicate of CA1018
dotnet_diagnostic.MA0097.severity = none # Duplicate of CA1036
dotnet_diagnostic.MA0070.severity = none # Duplicate of CA1041
dotnet_diagnostic.MA0047.severity = none # Declare types in namespaces; disabled because CA1050 is the canonical namespace-placement rule
dotnet_diagnostic.MA0013.severity = none # Duplicate of CA1058
dotnet_diagnostic.MA0086.severity = none # Duplicate of CA1065
dotnet_diagnostic.MA0095.severity = none # Duplicate of CA1067
dotnet_diagnostic.MA0011.severity = none # Duplicate of CA1304 and CA1305
dotnet_diagnostic.MA0001.severity = none # Duplicate of CA1307, CA1309, and CA1310
dotnet_diagnostic.MA0074.severity = none # Duplicate of CA1307 and CA1309
dotnet_diagnostic.MA0043.severity = none # Duplicate of CA1507
dotnet_diagnostic.MA0057.severity = none # Duplicate of CA1710
dotnet_diagnostic.MA0058.severity = none # Duplicate of CA1710
dotnet_diagnostic.MA0059.severity = none # Duplicate of CA1710
dotnet_diagnostic.MA0049.severity = none # Duplicate of CA1724
dotnet_diagnostic.MA0005.severity = none # Duplicate of CA1825
dotnet_diagnostic.MA0028.severity = none # Duplicate of CA1830 and CA1834
dotnet_diagnostic.MA0112.severity = none # Duplicate of CA1860
dotnet_diagnostic.MA0027.severity = none # Duplicate of CA2200
dotnet_diagnostic.MA0012.severity = none # Duplicate of CA2201
dotnet_diagnostic.MA0014.severity = none # Duplicate of CA2201
dotnet_diagnostic.MA0062.severity = none # Duplicate of CA2217
dotnet_diagnostic.MA0072.severity = none # Duplicate of CA2219
dotnet_diagnostic.MA0082.severity = none # Duplicate of CA2242
dotnet_diagnostic.MA0033.severity = none # Duplicate of CA2259
dotnet_diagnostic.MA0131.severity = none # Duplicate of CA2264
dotnet_diagnostic.MA0039.severity = none # Duplicate of CA5359
dotnet_diagnostic.MA0087.severity = none # Duplicate of S3450
dotnet_diagnostic.MA0048.severity = none # Project policy permits partial types and related private types to share purpose-named files
dotnet_diagnostic.CA1002.severity = none # Prefer MA0016 for collection abstractions
dotnet_diagnostic.CA1812.severity = none # Prefer MA0182, which avoids generic and typeof false positives
dotnet_diagnostic.CA1815.severity = none # Duplicate of MA0065 and MA0066
dotnet_diagnostic.CA1819.severity = none # Prefer MA0016 for array-returning members
dotnet_diagnostic.CA1826.severity = none # Prefer MA0020, which reports additional collection-specific cases
dotnet_diagnostic.CA1827.severity = none # Prefer MA0031 for broader Count() optimizations
dotnet_diagnostic.CA1849.severity = none # Prefer MA0042 for fewer false positives and CreateAsyncScope support
dotnet_diagnostic.CA1852.severity = none # Project policy does not require sealing types solely because they currently have no derived types
dotnet_diagnostic.CA2016.severity = none # Prefer the Meziantou CancellationToken rules below for broader coverage
dotnet_diagnostic.MA0032.severity = error # Use an overload with a CancellationToken even when no token is available in scope
dotnet_diagnostic.MA0080.severity = error # Use a cancellation token with asynchronous enumeration even when no token is available in scope
dotnet_diagnostic.CA2022.severity = none # Prefer MA0060 for ignored Stream read results
dotnet_diagnostic.CA2208.severity = none # Prefer MA0015, which reports additional argument-validation cases
dotnet_diagnostic.CA2214.severity = none # Prefer MA0056, which also reports virtual property and inherited virtual member calls
dotnet_diagnostic.IDE0330.severity = none # Prefer MA0158, which also supports variables in methods
dotnet_diagnostic.S6580.severity = none # Prefer CA1304 and CA1305; S6580 only applies to parse methods

# Cross-analyzer ownership

# ConfigureAwaitChecker.Analyzer is intentionally not referenced because MA0004 owns ConfigureAwait analysis.
dotnet_diagnostic.MA0004.severity = error # Use Task.ConfigureAwait; enabled as the single context-aware ConfigureAwait rule
dotnet_diagnostic.CA2007.severity = none # Consider calling ConfigureAwait on the awaited task; disabled because MA0004 supports context-aware configuration
dotnet_diagnostic.VSTHRD111.severity = none # Use ConfigureAwait(bool); disabled because MA0004 avoids requiring ConfigureAwait where context capture is intended

# Async invocation and delegate conventions
dotnet_diagnostic.MA0134.severity = error # Observe result of async calls; enabled as the owner for unobserved awaitables in synchronous methods
dotnet_diagnostic.CS4014.severity = error # Unawaited call in an async method; enabled because it complements MA0134 in async methods
dotnet_diagnostic.VSTHRD110.severity = none # Observe result of async calls; disabled because MA0134 provides broader awaitable support
dotnet_diagnostic.VSTHRD100.severity = error # Avoid async void methods; enabled as the owner for async void method declarations
dotnet_diagnostic.VSTHRD101.severity = error # Avoid unsupported async delegates; enabled as the owner for async delegates converted to void-returning delegates
dotnet_diagnostic.S3168.severity = none # "async" methods should not return "void"; disabled because VSTHRD100 and VSTHRD101 split this analysis precisely
dotnet_diagnostic.SS001.severity = none # Async methods should return a Task to make them awaitable; disabled because VSTHRD100 owns async void methods
dotnet_diagnostic.MA0147.severity = none # Avoid async void method for delegate; disabled because VSTHRD101 owns unsupported async delegates

# Tasks used with using statements
dotnet_diagnostic.MA0129.severity = error # Await task in using statement; enabled as the owner for accidentally disposing a Task instead of its result
dotnet_diagnostic.IDISP013.severity = error # Await in using; enabled because it catches resources disposed before a returned Task completes
dotnet_diagnostic.VSTHRD107.severity = none # Await Task within using expression; disabled because MA0129 covers the same misuse more broadly

# Null Task returns
dotnet_diagnostic.VSTHRD114.severity = error # Avoid returning a null Task; enabled as the single owner for null Task returns
dotnet_diagnostic.MA0022.severity = none # Return Task.FromResult instead of returning null; disabled because VSTHRD114 owns null Task returns
dotnet_diagnostic.RCS1210.severity = none # Return completed task instead of returning null; disabled because VSTHRD114 owns null Task returns
dotnet_diagnostic.S4586.severity = none # Non-async "Task/Task<T>" methods should not return null; disabled because VSTHRD114 owns null Task returns

# Locking
dotnet_diagnostic.MT1000.severity = error # Lock on publicly accessible member; enabled because the MT analyzer owns locking correctness
dotnet_diagnostic.MT1001.severity = error # Lock on this reference; enabled because the MT analyzer owns locking correctness
dotnet_diagnostic.MT1002.severity = error # Lock on object with weak identity; enabled because the MT analyzer owns locking correctness
dotnet_diagnostic.MT1003.severity = error # Lock on non-readonly member; enabled because the MT analyzer owns locking correctness
dotnet_diagnostic.MT1004.severity = error # Lock on value type instance; enabled because the MT analyzer owns locking correctness
dotnet_diagnostic.CA2002.severity = none # Do not lock on objects with weak identity; disabled because MT1002 owns weak-identity locking
dotnet_diagnostic.S3998.severity = none # Threads should not lock on objects with weak identity; disabled because MT1002 owns weak-identity locking
dotnet_diagnostic.MA0064.severity = none # Avoid locking on publicly accessible instance; disabled because MT1000 and MT1001 own public-instance locking
dotnet_diagnostic.RCS1059.severity = none # Avoid locking on publicly accessible instance; disabled because MT1000 and MT1001 own public-instance locking
dotnet_diagnostic.S2445.severity = none # Blocks should be synchronized on read-only fields; disabled because MT1003 owns mutable lock fields
dotnet_diagnostic.S2551.severity = none # Shared resources should not be used for locking; disabled because MT1000 and MT1002 own unsafe lock targets
dotnet_diagnostic.SS048.severity = none # A lock was taken using an instance of a discouraged type. System.String, System.Type and 'this' references can all lead to deadlocks and should be replaced with a System.Object instance instead.; disabled because MT1001 and MT1002 own unsafe lock targets
dotnet_diagnostic.SS051.severity = none # A lock was obtained on a mutable field which can lead to deadlocks when a new value is assigned. Mark the field as readonly to prevent re-assignment after a lock is taken.; disabled because MT1003 owns mutable lock fields

# Disposable ownership and lifetime
dotnet_diagnostic.IDISP001.severity = error # Dispose created; enabled because IDisposableAnalyzers owns disposal of created instances
dotnet_diagnostic.IDISP004.severity = error # Don't ignore created IDisposable; enabled because IDisposableAnalyzers owns ignored created instances
dotnet_diagnostic.CA2000.severity = none # Dispose objects before losing scope; disabled because IDISP001 and IDISP004 provide the canonical ownership analysis
dotnet_diagnostic.IDISP002.severity = error # Dispose member; enabled because IDisposableAnalyzers owns disposal of fields and properties
dotnet_diagnostic.CA2213.severity = none # Disposable fields should be disposed; disabled because IDISP002 owns disposable members
dotnet_diagnostic.SS066.severity = none # A disposable field is not disposed by the containing type; disabled because IDISP002 owns disposable members
dotnet_diagnostic.IDISP018.severity = error # Call SuppressFinalize; enabled because IDisposableAnalyzers owns disposal-pattern mechanics
dotnet_diagnostic.IDISP019.severity = error # Call SuppressFinalize; enabled because IDisposableAnalyzers owns disposal-pattern mechanics
dotnet_diagnostic.IDISP020.severity = error # Call SuppressFinalize(this); enabled because IDisposableAnalyzers owns disposal-pattern mechanics
dotnet_diagnostic.CA1816.severity = none # Dispose methods should call SuppressFinalize; disabled because IDISP018, IDISP019, and IDISP020 model the disposal patterns separately
dotnet_diagnostic.IDISP011.severity = error # Don't return disposed instance; enabled because IDisposableAnalyzers owns disposed-value lifetime analysis
dotnet_diagnostic.S2997.severity = none # "IDisposables" created in a "using" statement should not be returned; disabled because IDISP011 owns returned disposed instances

# ThreadStatic fields
dotnet_diagnostic.CA2259.severity = error # 'ThreadStatic' only affects static fields; enabled as the owner for ThreadStatic placement
dotnet_diagnostic.S3005.severity = none # "ThreadStatic" should not be used on non-static fields; disabled because CA2259 owns ThreadStatic placement
dotnet_diagnostic.SS042.severity = none # [ThreadStatic] can only be used on static fields; disabled because CA2259 owns ThreadStatic placement
dotnet_diagnostic.CA2019.severity = error # Improper 'ThreadStatic' field initialization; enabled as the owner for ThreadStatic initialization
dotnet_diagnostic.S2996.severity = none # "ThreadStatic" fields should not be initialized; disabled because CA2019 owns ThreadStatic initialization
dotnet_diagnostic.SS052.severity = none # A field is marked as [ThreadStatic] so it cannot contain an initializer. The field initializer is only executed for the first thread.; disabled because CA2019 owns ThreadStatic initialization

# Collection, LINQ, and string performance
dotnet_diagnostic.MA0020.severity = error # Use direct methods instead of LINQ methods; enabled because it covers the collection-specific Sonar cases and additional APIs
dotnet_diagnostic.S6602.severity = none # "Find" method should be used instead of the "FirstOrDefault" extension; disabled because MA0020 provides broader direct-method analysis
dotnet_diagnostic.S6603.severity = none # The collection-specific "TrueForAll" method should be used instead of the "All" extension; disabled because MA0020 provides broader direct-method analysis
dotnet_diagnostic.S6605.severity = none # Collection-specific "Exists" method should be used instead of the "Any" extension; disabled because MA0020 provides broader direct-method analysis
dotnet_diagnostic.MA0031.severity = error # Optimize Enumerable.Count() usage; enabled as the broader owner for Count optimizations
dotnet_diagnostic.CA1829.severity = none # Use Length/Count property instead of Count() when available; disabled because MA0031 covers additional Count patterns
dotnet_diagnostic.MA0089.severity = error # Optimize string method usage; enabled because it covers all relevant string-to-char overload optimizations
dotnet_diagnostic.CA1865.severity = none # Use char overload; disabled because MA0089 owns StartsWith optimization
dotnet_diagnostic.CA1866.severity = none # Use char overload; disabled because MA0089 owns EndsWith optimization
dotnet_diagnostic.CA1867.severity = none # Use char overload; disabled because MA0089 owns IndexOf optimization
dotnet_diagnostic.S6610.severity = none # "StartsWith" and "EndsWith" overloads that take a "char" should be used instead of the ones that take a "string"; disabled because MA0089 owns string-to-char overload analysis

# ToString fallback analysis
dotnet_diagnostic.MA0150.severity = error # Do not call ToString() when the type falls back to object.ToString(); enabled as the owner for explicit calls
dotnet_diagnostic.ExplicitToStringWithoutOverrideAnalyzer.severity = none # Suspicious conversion to string; disabled because MA0150 owns explicit ToString calls
dotnet_diagnostic.StringFormatArgumentImplicitToStringAnalyzer.severity = error # Suspicious conversion to string; enabled because MA0150 does not inspect String.Format arguments
dotnet_diagnostic.InterpolatedStringImplicitToStringAnalyzer.severity = error # Suspicious conversion to string; enabled because MA0150 does not inspect interpolated-string conversions

# Framework design and naming rules owned by the .NET SDK analyzers
dotnet_diagnostic.CA1018.severity = error # Mark attributes with AttributeUsageAttribute; enabled as the canonical attribute-usage rule
dotnet_diagnostic.S3993.severity = none # Custom attributes should be marked with "System.AttributeUsageAttribute"; disabled because CA1018 owns attribute usage
dotnet_diagnostic.CA1050.severity = error # Declare types in namespaces; enabled as the canonical namespace-placement rule
dotnet_diagnostic.S3903.severity = none # Types should be defined in named namespaces; disabled because CA1050 owns namespace placement
dotnet_diagnostic.MA0017.severity = error # Abstract types should not have public or internal constructors; enabled because it covers the public cases and the additional internal-constructor case
dotnet_diagnostic.CA1012.severity = none # Abstract types should not have public constructors; disabled because MA0017 provides broader constructor-accessibility coverage
dotnet_diagnostic.RCS1160.severity = none # Abstract type should not have public constructors; disabled because MA0017 provides broader constructor-accessibility coverage
dotnet_diagnostic.S3442.severity = none # "abstract" classes should not have "public" constructors; disabled because MA0017 provides broader constructor-accessibility coverage
dotnet_diagnostic.CA1036.severity = error # Override methods on comparable types; enabled as the canonical comparable-type rule
dotnet_diagnostic.S1210.severity = none # "Equals" and the comparison operators should be overridden when implementing "IComparable"; disabled because CA1036 owns comparable types
dotnet_diagnostic.CA1046.severity = error # Do not overload equality operator on reference types; enabled as the canonical reference-equality rule
dotnet_diagnostic.S3875.severity = none # "operator==" should not be overloaded on reference types; disabled because CA1046 owns reference equality
dotnet_diagnostic.CA1061.severity = error # Do not hide base class methods; enabled as the canonical hidden-base-method rule
dotnet_diagnostic.S4019.severity = none # Base class methods should not be hidden; disabled because CA1061 owns hidden base methods
dotnet_diagnostic.CA1721.severity = error # Property names should not match get methods; enabled as the canonical property/get-method naming rule
dotnet_diagnostic.S4059.severity = none # Property names should not match get methods; disabled because CA1721 owns this naming rule
dotnet_diagnostic.CA1724.severity = error # Type names should not match namespaces; enabled as the canonical type/namespace naming rule
dotnet_diagnostic.S4041.severity = none # Type names should not match namespaces; disabled because CA1724 owns this naming rule
dotnet_diagnostic.CA1727.severity = error # Use PascalCase for named placeholders; enabled as the canonical placeholder-naming rule
dotnet_diagnostic.S6678.severity = none # Use PascalCase for named placeholders; disabled because CA1727 owns placeholder naming
dotnet_diagnostic.CA1016.severity = error # Mark assemblies with assembly version; enabled as the canonical assembly-version rule
dotnet_diagnostic.S3904.severity = none # Assemblies should have version information; disabled because CA1016 owns assembly versions
dotnet_diagnostic.CA1070.severity = error # Do not declare event fields as virtual; enabled as the canonical virtual-event rule
dotnet_diagnostic.S2290.severity = none # Field-like events should not be virtual; disabled because CA1070 owns virtual events
dotnet_diagnostic.CA2242.severity = error # Test for NaN correctly; enabled as the canonical NaN-comparison rule
dotnet_diagnostic.S2688.severity = none # "NaN" should not be used in comparisons; disabled because CA2242 owns NaN comparisons
dotnet_diagnostic.CA2013.severity = error # Do not use ReferenceEquals with value types; enabled as the canonical ReferenceEquals rule
dotnet_diagnostic.S2995.severity = none # "Object.ReferenceEquals" should not be used for value types; disabled because CA2013 owns value-type ReferenceEquals calls

# General-purpose rules owned by Meziantou.Analyzer
dotnet_diagnostic.MA0019.severity = error # Use EventArgs.Empty; enabled as the canonical EventArgs allocation rule
dotnet_diagnostic.RCS1204.severity = none # Use EventArgs.Empty; disabled because MA0019 owns EventArgs allocation
dotnet_diagnostic.MA0037.severity = error # Remove empty statement; enabled as the canonical empty-statement rule
dotnet_diagnostic.S1116.severity = none # Empty statements should be removed; disabled because MA0037 owns empty statements
dotnet_diagnostic.MA0044.severity = error # Remove useless ToString call; enabled as the broader canonical redundant-ToString rule
dotnet_diagnostic.RCS1097.severity = none # Remove redundant 'ToString' call; disabled because MA0044 owns redundant ToString calls
dotnet_diagnostic.SS064.severity = none # Unnecessary ToString() call on Span<char> or ReadOnlySpan<char>; disabled because MA0044 covers this case
dotnet_diagnostic.MA0050.severity = error # Validate arguments correctly in iterator methods; enabled as the canonical iterator-validation rule
dotnet_diagnostic.RCS1227.severity = none # Validate arguments correctly; disabled because MA0050 owns iterator argument validation
dotnet_diagnostic.MA0056.severity = error # Do not call overridable members in constructor; enabled as the broader canonical constructor-call rule
dotnet_diagnostic.S1699.severity = none # Constructors should only call non-overridable methods; disabled because MA0056 owns constructor calls
dotnet_diagnostic.MA0063.severity = error # Use Where before OrderBy; enabled as the canonical filter-before-sort rule
dotnet_diagnostic.S6607.severity = none # The collection should be filtered before sorting by using "Where" before "OrderBy"; disabled because MA0063 owns filter-before-sort analysis
dotnet_diagnostic.MA0067.severity = error # Use Guid.Empty; enabled as the canonical empty-Guid rule
dotnet_diagnostic.S4581.severity = none # "new Guid()" should not be used; disabled because MA0067 owns empty Guid creation
dotnet_diagnostic.SS010.severity = none # Attempted to create empty guid; disabled because MA0067 owns empty Guid creation
dotnet_diagnostic.MA0083.severity = error # ConstructorArgument parameters should exist in constructors; enabled as the canonical ConstructorArgument rule
dotnet_diagnostic.S4260.severity = none # "ConstructorArgument" parameters should exist in constructors; disabled because MA0083 owns this analysis
dotnet_diagnostic.MA0085.severity = error # Anonymous delegates should not be used to unsubscribe from Events; enabled as the canonical event-unsubscription rule
dotnet_diagnostic.S3244.severity = none # Anonymous delegates should not be used to unsubscribe from Events; disabled because MA0085 owns this analysis
dotnet_diagnostic.MA0088.severity = error # Use [DefaultParameterValue] instead of [DefaultValue]; enabled as the canonical default-parameter-attribute rule
dotnet_diagnostic.S3451.severity = none # "[DefaultValue]" should not be used when "[DefaultParameterValue]" is meant; disabled because MA0088 owns this analysis
dotnet_diagnostic.MA0111.severity = error # Use string.Create instead of FormattableString; enabled as the canonical FormattableString optimization
dotnet_diagnostic.S6618.severity = none # "string.Create" should be used instead of "FormattableString"; disabled because MA0111 owns this optimization
dotnet_diagnostic.MA0118.severity = error # [JSInvokable] methods must be public; enabled as the canonical JSInvokable accessibility rule
dotnet_diagnostic.S6798.severity = none # [JSInvokable] attribute should only be used on public methods; disabled because MA0118 owns this analysis
dotnet_diagnostic.MA0184.severity = error # Do not use interpolated string without parameters; enabled as the canonical redundant-interpolation rule
dotnet_diagnostic.RCS1214.severity = none # Unnecessary interpolated string; disabled because MA0184 owns redundant interpolation
dotnet_diagnostic.MA0105.severity = error # Use the lambda parameters instead of using a closure; enabled as the broader canonical ConcurrentDictionary rule
dotnet_diagnostic.S6612.severity = none # The lambda parameter should be used instead of capturing arguments in "ConcurrentDictionary" methods; disabled because MA0105 owns this analysis

# Rules better owned by Sonar or Roslynator
dotnet_diagnostic.S3443.severity = error # Type should not be examined on "System.Type" instances; enabled because it covers both GetType and IsInstanceOfType misuse
dotnet_diagnostic.MA0130.severity = none # GetType() should not be used on System.Type instances; disabled because S3443 provides broader coverage
dotnet_diagnostic.S3262.severity = error # "params" should be used on overrides; enabled as the owner for omitted params modifiers
dotnet_diagnostic.S3600.severity = error # "params" should not be introduced on overrides; enabled because it covers the complementary modifier mismatch
dotnet_diagnostic.MA0081.severity = none # Method overrides should not omit params keyword; disabled because S3262 owns omitted params modifiers
dotnet_diagnostic.S3358.severity = error # Ternary operators should not be nested; enabled as the canonical nested-ternary rule
dotnet_diagnostic.RCS1238.severity = none # Avoid nested ?: operators; disabled because S3358 owns nested ternaries
dotnet_diagnostic.RCS1246.severity = error # Use element access; enabled as the canonical IList element-access rule
dotnet_diagnostic.S6608.severity = none # Prefer indexing instead of "Enumerable" methods on types implementing "IList"; disabled because RCS1246 owns element access

# Static members and initialization
dotnet_diagnostic.S2223.severity = error # Non-constant static fields should not be visible; enabled as the canonical visible-static-field rule
dotnet_diagnostic.CA2211.severity = none # Non-constant fields should not be visible; disabled because S2223 is the enforced owner
dotnet_diagnostic.MA0069.severity = none # Non-constant static fields should not be visible; disabled because S2223 is the enforced owner
dotnet_diagnostic.CA1823.severity = error # Avoid unused private fields; enabled as the canonical unused-private-field rule
dotnet_diagnostic.S4487.severity = none # Unread "private" fields should be removed; disabled because CA1823 owns unused private fields
dotnet_diagnostic.S1118.severity = error # Utility classes should not have public constructors; owns constructor accessibility
dotnet_diagnostic.CA1052.severity = error # Static holder types should be static or sealed; complements S1118, which permits protected constructors
dotnet_diagnostic.MA0036.severity = none # Make class static; disabled because S1118 is the enforced owner
dotnet_diagnostic.RCS1102.severity = none # Make class static; disabled because S1118 is the enforced owner
dotnet_diagnostic.S2325.severity = error # Methods and properties that don't access instance data should be static; enabled as the canonical static-member rule
dotnet_diagnostic.CA1822.severity = none # Mark members as static; disabled because S2325 is the enforced owner
dotnet_diagnostic.MA0041.severity = none # Make property static (deprecated, use CA1822 instead); disabled because S2325 is the enforced owner
dotnet_diagnostic.S2933.severity = error # Fields that are only assigned in the constructor should be "readonly"; enabled as the canonical readonly-field rule
dotnet_diagnostic.MA0102.severity = none # Make member readonly; disabled because S2933 is the enforced owner
dotnet_diagnostic.RCS1169.severity = none # Make field read-only; disabled because S2933 is the enforced owner
dotnet_diagnostic.MA0195.severity = error # Do not use static fields before they are initialized; enabled as the canonical static-initialization-order rule
dotnet_diagnostic.S3263.severity = none # Static fields should appear in the order they must be initialized; disabled because MA0195 owns initialization order
dotnet_diagnostic.SS045.severity = none # A static field relies on the value of another static field which is defined in the same type. Static fields are initialized in order of appearance.; disabled because MA0195 owns initialization order

# Finalizers and unexpected exception locations
dotnet_diagnostic.MA0055.severity = error # Do not use finalizer; enabled because project policy prohibits finalizers
dotnet_diagnostic.CA1821.severity = none # Remove empty Finalizers; disabled because MA0055 prohibits all finalizers
dotnet_diagnostic.CA2015.severity = none # Do not define finalizers for types derived from MemoryManager<T>; disabled because MA0055 prohibits all finalizers
dotnet_diagnostic.CA2216.severity = none # Disposable types should declare finalizer; disabled because it conflicts with the no-finalizer policy enforced by MA0055
dotnet_diagnostic.S1048.severity = none # Finalizers should not throw exceptions; disabled because MA0055 prohibits all finalizers
dotnet_diagnostic.CA1065.severity = error # Do not raise exceptions in unexpected locations; enabled as the owner for exceptions from unexpected methods
dotnet_diagnostic.S3877.severity = none # Exceptions should not be thrown from unexpected methods; disabled because CA1065 owns unexpected exception locations
dotnet_diagnostic.SS024.severity = none # An exception is thrown from a static constructor.; disabled because CA1065 owns unexpected exception locations
dotnet_diagnostic.SS027.severity = none # An exception is thrown from a Dispose method.; disabled because CA1065 owns unexpected exception locations
dotnet_diagnostic.SS028.severity = none # An exception is thrown from a finalizer method.; disabled because MA0055 prohibits finalizers and CA1065 owns exception locations
dotnet_diagnostic.SS029.severity = none # An exception is thrown from a GetHashCode() method.; disabled because CA1065 owns unexpected exception locations
dotnet_diagnostic.SS030.severity = none # An exception is thrown from an Equals() method.; disabled because CA1065 owns unexpected exception locations
dotnet_diagnostic.CA2219.severity = error # Do not raise exceptions in finally clauses; enabled as the canonical finally-clause rule
dotnet_diagnostic.S1163.severity = none # Exceptions should not be thrown in finally blocks; disabled because CA2219 owns finally clauses
dotnet_diagnostic.SS025.severity = none # An exception is thrown from a finally block.; disabled because CA2219 owns finally clauses

# ValueTask and hash-code correctness
dotnet_diagnostic.CA2012.severity = error # Use ValueTasks correctly; enabled as the canonical ValueTask-consumption rule
dotnet_diagnostic.SS063.severity = none # A ValueTask was awaited multiple times; disabled because CA2012 owns ValueTask consumption
dotnet_diagnostic.SS008.severity = error # GetHashCode() refers to mutable or static member; enabled as the canonical mutable-hash-state rule
dotnet_diagnostic.S2328.severity = none # "GetHashCode" should not reference mutable fields; disabled because SS008 is the enforced owner

# Policy exceptions: disabled rules

# .NET SDK analyzers
dotnet_diagnostic.CA1014.severity = none # Mark assemblies with CLSCompliantAttribute
dotnet_diagnostic.CA1024.severity = none # Use properties where appropriate
dotnet_diagnostic.CA1028.severity = none # Enum storage should be Int32
dotnet_diagnostic.CA1031.severity = none # Do not catch general exception types
dotnet_diagnostic.CA1063.severity = none # Implement IDisposable correctly
dotnet_diagnostic.CA1064.severity = none # Exceptions should be public
dotnet_diagnostic.CA1303.severity = none # Do not pass literals as localized parameters
