<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--Default project info-->
  <PropertyGroup>
    <Authors>Ian Qvist</Authors>
    <Copyright>Copyright 2026, by Ian Qvist. All rights reserved.</Copyright>
  </PropertyGroup>

  <!--Default project settings-->
  <PropertyGroup>
    <!--Template system-->
    <IncludeBaseProject>true</IncludeBaseProject>
    <IncludeInternalsVisibleTo>true</IncludeInternalsVisibleTo>
    <IncludeAnalyzers>true</IncludeAnalyzers>
    <ContinueOnCapturedContext Condition="'$(ContinueOnCapturedContext)' == ''">false</ContinueOnCapturedContext>

    <!--Assembly settings-->
    <RootNamespace>Genbox.$(MSBuildProjectName)</RootNamespace>
    <AssemblyNamePrefix Condition="'$(_IsPacking)' == 'true' OR '$(_IsPublishing)' == 'true'">Genbox.</AssemblyNamePrefix>
    <AssemblyName Condition="'$(AssemblyNamePrefix)' != ''">$(AssemblyNamePrefix)$(MSBuildProjectName)</AssemblyName>

    <!--C# settings-->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Features>strict</Features>
    <ImplicitUsings>true</ImplicitUsings>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>

    <!--.NET settings-->
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>

    <!--Package settings-->
    <RepositoryType>Git</RepositoryType>
    <PackageProjectUrl>https://github.com/Genbox/$(MSBuildProjectName)</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--Enable analyzers during builds and live analysis by default-->
    <EnableNETAnalyzers>$(IncludeAnalyzers)</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>$(IncludeAnalyzers)</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <AnalysisMode>all</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>

    <!--NuGet settings-->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>

    <!--Other settings-->
    <CopyRetryCount>2</CopyRetryCount>
    <CopyRetryDelayMilliseconds>500</CopyRetryDelayMilliseconds>
    <ErrorReport>none</ErrorReport>
    <SatelliteResourceLanguages>en-US;en</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);packages.lock.json</DefaultItemExcludes>

    <!--Force reproducible builds-->
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>

    <!--SourceLink-->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--NuGet auditing-->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <_LastDot>$(MSBuildProjectName.LastIndexOf('.', StringComparison.Ordinal))</_LastDot>
    <BaseProject Condition="$(_LastDot) &gt; 0">$(MSBuildProjectName.Substring(0, $(_LastDot)))</BaseProject>
    <ProjectType Condition="$(_LastDot) &gt; 0">$(MSBuildProjectName.Substring($([MSBuild]::Add($(_LastDot), 1))))</ProjectType>
  </PropertyGroup>

  <ItemGroup>
    <!--Analyzers-->
    <AdditionalFiles Include="../../Imports/BannedSymbols.txt" Condition="Exists('../../Imports/BannedSymbols.txt')" />

    <!--Don't show the packages.lock file in projects-->
    <None Remove="packages.lock.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' AND '$(IsPackable)' == 'true'">
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <Import Project="../Locals/Directory.Build.props" Condition="Exists('../Locals/Directory.Build.props')" />
  <Import Project="../Imports/$(ProjectType).props" Condition="Exists('../Imports/$(ProjectType).props')" />
  <Import Project="../Imports/Analyzers.props" Condition="'$(IncludeAnalyzers)' == 'True' AND Exists('../Imports/Analyzers.props')" />

  <PropertyGroup Condition="'$(DisableConfigureAwaitFody)' != 'true' AND '$(DisableFody)' != 'true'">
    <WeaverConfiguration>
      <Weavers>
        <ConfigureAwait ContinueOnCapturedContext="$(ContinueOnCapturedContext)" />
      </Weavers>
    </WeaverConfiguration>
  </PropertyGroup>

  <ItemGroup Condition="'$(DisableConfigureAwaitFody)' != 'true' AND '$(DisableFody)' != 'true'">
    <PackageReference Include="Fody" PrivateAssets="all" />
    <PackageReference Include="ConfigureAwait.Fody" PrivateAssets="all" />
  </ItemGroup>

</Project>